---
import type {Testimonial} from '../lib/queries'

export interface Props {
  testimonials?: Testimonial[] | undefined
  heading?: string | undefined
}

const {testimonials = [], heading = 'ביקורות מאומתות ע"י שבט אמהות'} = Astro.props
const items = testimonials.filter((t) => t.quote)
---
{items.length > 0 && (
  <section class="wa-reviews">
    <h2>{heading}</h2>
    <div class="wa-slider" data-wa-slider>
      {items.length > 1 && (
        <button class="wa-arrow wa-arrow-prev" type="button" data-wa-prev aria-label="הביקורת הקודמת">›</button>
      )}
      <div class="wa-track" data-wa-track>
        {items.map((t) => (
          <div class="wa-slide">
            <div class="wa-phone">
              <span class="wa-phone-notch" aria-hidden="true"></span>
              <div class="wa-phone-screen">
                <div class="wa-chat-bar">
                  <span class="wa-chat-back" aria-hidden="true">›</span>
                  <span class="wa-chat-avatar" aria-hidden="true">💬</span>
                  <span class="wa-chat-id">
                    <strong>שבט אמהות</strong>
                    <em>ביקורת מאומתת</em>
                  </span>
                </div>
                <div class="wa-chat-body">
                  <div class="wa-bubble">
                    <p>{t.quote}</p>
                    <span class="wa-bubble-meta">
                      {t.author && <b>— {t.author}</b>}
                      <time>09:14</time>
                    </span>
                  </div>
                </div>
                <div class="wa-chat-input" aria-hidden="true">
                  <span class="wa-chat-input-field">הקלידי הודעה</span>
                  <span class="wa-chat-input-mic">🎤</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      {items.length > 1 && (
        <button class="wa-arrow wa-arrow-next" type="button" data-wa-next aria-label="הביקורת הבאה">‹</button>
      )}
    </div>
  </section>
)}

<style>
  .wa-reviews { margin-top: 2rem; }
  .wa-reviews h2 { text-align: center; }

  .wa-slider { position: relative; display: flex; align-items: center; gap: .5rem; }

  .wa-track {
    display: flex;
    gap: 1.1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: .5rem .2rem 1rem;
    scrollbar-width: none;
  }
  .wa-track::-webkit-scrollbar { display: none; }

  .wa-slide { flex: 0 0 auto; scroll-snap-align: center; }

  .wa-phone {
    position: relative;
    width: min(260px, 74vw);
    aspect-ratio: 9 / 19.5;
    background: var(--ink);
    border-radius: 2.2rem;
    padding: 10px;
    box-shadow: var(--shadow-soft);
  }
  .wa-phone-notch {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 36%;
    height: 18px;
    background: var(--ink);
    border-radius: 999px;
    z-index: 2;
  }
  .wa-phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 1.7rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(circle at 15% 20%, rgba(0,0,0,.04) 0 2px, transparent 2px),
      radial-gradient(circle at 65% 55%, rgba(0,0,0,.04) 0 2px, transparent 2px),
      radial-gradient(circle at 35% 85%, rgba(0,0,0,.04) 0 2px, transparent 2px),
      #e7ddd0;
    background-size: 60px 60px, 70px 70px, 50px 50px, auto;
    font-family: var(--sans);
  }

  .wa-chat-bar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: 30px .7rem .5rem;
    background: #075e54;
    color: #fff;
  }
  .wa-chat-back { font-size: 1.3rem; line-height: 1; transform: scaleX(-1); }
  .wa-chat-avatar {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255,255,255,.18);
    font-size: .85rem;
  }
  .wa-chat-id { display: flex; flex-direction: column; line-height: 1.25; }
  .wa-chat-id strong { font-size: .78rem; }
  .wa-chat-id em { font-style: normal; font-size: .62rem; color: rgba(255,255,255,.75); }

  .wa-chat-body { flex: 1 1 auto; display: flex; align-items: flex-start; padding: .7rem; overflow: hidden; }

  .wa-bubble {
    align-self: flex-start;
    max-width: 92%;
    background: #fff;
    border-radius: 6px;
    border-top-right-radius: 0;
    padding: .45rem .55rem .3rem;
    box-shadow: 0 1px 1px rgba(0,0,0,.12);
  }
  .wa-bubble p {
    margin: 0 0 .2rem;
    font-size: .66rem;
    line-height: 1.45;
    color: #1b1b1b;
  }
  .wa-bubble-meta {
    display: flex;
    justify-content: space-between;
    gap: .4rem;
    font-size: .55rem;
    color: #667781;
  }
  .wa-bubble-meta b { font-weight: 700; color: var(--brand); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .wa-chat-input {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: .4rem;
    padding: .45rem .6rem;
    background: #f0f0f0;
  }
  .wa-chat-input-field {
    flex: 1;
    background: #fff;
    border-radius: 999px;
    padding: .35rem .6rem;
    font-size: .6rem;
    color: #9aa0a3;
  }
  .wa-chat-input-mic { font-size: .8rem; }

  .wa-arrow {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--brand);
    font-size: 1.3rem;
    cursor: pointer;
    box-shadow: var(--shadow-soft);
  }
  .wa-arrow:hover { background: var(--peach-soft); }

  @media (max-width: 560px) {
    .wa-arrow { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-wa-slider]').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('[data-wa-track]')
    if (!track) return
    const isRtl = getComputedStyle(track).direction === 'rtl'
    const step = () => (track.querySelector<HTMLElement>('.wa-slide')?.offsetWidth ?? track.clientWidth) + 18

    slider.querySelector<HTMLButtonElement>('[data-wa-next]')?.addEventListener('click', () => {
      track.scrollBy({left: step() * (isRtl ? -1 : 1), behavior: 'smooth'})
    })
    slider.querySelector<HTMLButtonElement>('[data-wa-prev]')?.addEventListener('click', () => {
      track.scrollBy({left: step() * (isRtl ? 1 : -1), behavior: 'smooth'})
    })
  })
</script>
