---
import Base from '../../layouts/Base.astro'
import LegacyContent from '../../components/LegacyContent.astro'
import ContactForm from '../../components/ContactForm.astro'
import WhatsAppReviews from '../../components/WhatsAppReviews.astro'
import {getPremiumDoulaSlugs, getPractitioner} from '../../lib/queries'
import {whatsappHref, mailtoHref, instagramHref, instagramHandle, instagramPostHref} from '../../lib/contact'
import {videoEmbedSrc} from '../../lib/video'

export async function getStaticPaths() {
  const slugs: string[] = await getPremiumDoulaSlugs()
  return slugs.map((slug) => ({params: {slug}}))
}

const {slug} = Astro.params
const d = await getPractitioner(slug!)

const wa = whatsappHref(d?.whatsapp, d?.phone)
const mailto = mailtoHref(d?.email)
const igPostUrl = instagramPostHref(d?.instagramPostUrl)
const igProfileUrl = instagramHref(d?.instagram)
const igHandle = instagramHandle(d?.instagram)
const bioBlocks = Array.isArray(d?.bio) ? d!.bio : []
const videoSrc = videoEmbedSrc(d?.videoUrl)

type LegacyBlock = { _type?: string; style?: string; children?: { text?: string }[] }
const contentBlocks = (blocks: unknown[] | undefined): LegacyBlock[] =>
  Array.isArray(blocks) ? blocks.filter((block): block is LegacyBlock => typeof block === 'object' && block !== null && '_type' in block) : []

const stripHeadings = (blocks: LegacyBlock[]): LegacyBlock[] => blocks.filter((block) => !/^h[1-6]$/.test(block.style ?? ''))

const accompanimentCards = [
  {title: 'פגישת היכרות', icon: 'meeting', blocks: stripHeadings(contentBlocks(d?.meetingInfo))},
  {title: '', icon: 'course', blocks: contentBlocks(d?.services)},
  {title: 'במהלך הלידה', icon: 'during', blocks: contentBlocks(d?.duringBirth)},
  {title: 'אחרי הלידה', icon: 'after', blocks: contentBlocks(d?.afterBirth)},
].filter((c) => c.blocks.length > 0)

const profileFacts = [
  {title: 'בתי החולים אליהם אני מגיעה', items: d?.hospitals},
  {title: 'הכשרות נוספות', items: d?.credentials},
  {title: 'שירותים נוספים שאני מציעה', items: d?.additionalServices},
  {title: 'מיקום', items: d?.regions},
].filter((section) => (section.items?.length ?? 0) > 0)
---
<Base title={`${d?.name} — דולה | שבט אמהות`} description={d?.title}>
  <article class="profile-shell wrap">
    {d?.photoUrl && (
      <div class="profile-photo-wrap">
        <img class="profile-photo" src={`${d.photoUrl}?w=480&h=480&fit=crop`} alt={d.name} />
      </div>
    )}
    <header class="profile-head">
      <div>
        <h1>{d?.name}</h1>
        <p class="title">{d?.title}</p>
        {d?.marketingSentence && <p class="marketing-sentence">{d.marketingSentence}</p>}
        <div class="tags">
          {(d?.hospitals || []).map((h: string) => <span class="chip">{h}</span>)}
          {(d?.supportStyle || []).map((s: string) => <span class="chip">{s}</span>)}
        </div>
      </div>
    </header>

    {d?.tagline && <p class="tagline">{d.tagline}</p>}
    {bioBlocks.length > 0 && <section class="article-body"><h2>האני מאמין שלי</h2><LegacyContent blocks={bioBlocks} /></section>}

    <div class="contact-links">
      {wa && (
        <a class="btn btn-wa" href={wa}>
          <svg class="wa-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.472-.148-.67.15-.198.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.148.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
            <path d="M12.001 2C6.478 2 2 6.477 2 12c0 1.99.585 3.845 1.596 5.405L2 22l4.735-1.556A9.953 9.953 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2zm0 18.09c-1.66 0-3.207-.48-4.51-1.31l-.323-.19-3.13 1.03 1.045-3.05-.207-.313A8.075 8.075 0 0 1 3.91 12c0-4.462 3.63-8.09 8.091-8.09 4.462 0 8.09 3.628 8.09 8.09 0 4.462-3.628 8.09-8.09 8.09z"></path>
          </svg>
          וואטסאפ
        </a>
      )}
      {mailto && <a class="btn btn-outline" href={mailto}>אימייל</a>}
    </div>

    {igPostUrl ? (
      <div class="ig-post-embed">
        <p>התוכן הבא מוצג מאינסטגרם. טעינתו תאפשר לאינסטגרם לקבל מידע על הביקור שלך.</p>
        <button class="btn btn-outline" type="button" data-instagram-load>טעינת הפוסט מאינסטגרם</button>
        <blockquote class="instagram-media" data-instgrm-permalink={igPostUrl} data-instgrm-version="14" hidden>
          <a href={igPostUrl} target="_blank" rel="noopener noreferrer">{`צפו בפוסט של ${d?.name} באינסטגרם`}</a>
        </blockquote>
      </div>
    ) : igProfileUrl && (
      <a class="ig-embed" href={igProfileUrl} target="_blank" rel="noopener noreferrer" aria-label={`עמוד האינסטגרם של ${d?.name}`}>
        <span class="ig-embed-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
            <circle cx="12" cy="12" r="4.3" />
            <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        </span>
        <span class="ig-embed-body">
          <strong>{d?.name} באינסטגרם</strong>
          <span class="ig-embed-handle">{igHandle}</span>
        </span>
      </a>
    )}

    {profileFacts.length > 0 && (
      <section class="profile-facts">
        <div class="grid profile-facts-grid">
          {profileFacts.map((section) => (
            <div class="card profile-fact-card">
              <h2>{section.title}</h2>
              <ul class="profile-fact-list">
                {section.items?.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <WhatsAppReviews testimonials={d?.testimonials} />

    {(d?.faq?.length ?? 0) > 0 && <section class="article-body"><h2>שאלות נפוצות</h2>{d?.faq?.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</section>}

    {accompanimentCards.length > 0 && (
      <section class="accompaniment">
        <h2>איך נראה ליווי לידה איתי?</h2>
        <div class="grid accompaniment-grid">
          {accompanimentCards.map((c) => (
            <div class="card accompaniment-card">
              <div class="accompaniment-card-head">
                <span class="accompaniment-icon" aria-hidden="true">
                  {c.icon === 'meeting' && (
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="8" r="3" />
                      <path d="M3.5 19c.5-3 2.7-5 5.5-5s5 2 5.5 5" />
                      <circle cx="17" cy="7" r="2.4" />
                      <path d="M14.8 12.2c2.3.2 4 2 4.4 4.3" />
                    </svg>
                  )}
                  {c.icon === 'course' && (
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 6.5c-1.6-1.2-3.7-1.8-6-1.8v13c2.3 0 4.4.6 6 1.8 1.6-1.2 3.7-1.8 6-1.8v-13c-2.3 0-4.4.6-6 1.8z" />
                      <path d="M12 6.5v13" />
                    </svg>
                  )}
                  {c.icon === 'during' && (
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20.5s-7.5-4.6-7.5-10.2C4.5 7 6.7 5 9.3 5c1.2 0 2.3.5 3 1.4L12 8l-.3-1.6c.7-.9 1.8-1.4 3-1.4 2.6 0 4.8 2 4.8 5.3 0 5.6-7.5 10.2-7.5 10.2z" />
                      <path d="M8.5 11h2l1.2-2 1.6 3.2 1-1.2h1.7" />
                    </svg>
                  )}
                  {c.icon === 'after' && (
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="7.5" r="3.2" />
                      <path d="M6 20c.6-3.6 3-5.8 6-5.8s5.4 2.2 6 5.8" />
                      <path d="M9.3 9.8c.9 1 1.7 1 2.7 0" />
                    </svg>
                  )}
                </span>
                {c.title && <h3>{c.title}</h3>}
              </div>
              <LegacyContent blocks={c.blocks} />
            </div>
          ))}
        </div>
      </section>
    )}

    {videoSrc && (
      <div class="video-frame">
        <iframe src={d?.videoCoverUrl ? undefined : videoSrc} data-video-src={videoSrc} title={`סרטון ${d?.name}`} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        {d?.videoCoverUrl && (
          <button class="video-cover-button" type="button" data-video-cover aria-label={`נגן סרטון ${d?.name}`}>
            <img src={`${d.videoCoverUrl}?w=760&fit=max`} alt={`סרטון ${d?.name}`} loading="lazy" />
            <span class="video-play-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="42" height="42" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            </span>
          </button>
        )}
      </div>
    )}
    {!videoSrc && d?.videoUrl && <a class="btn btn-outline" href={d.videoUrl} target="_blank" rel="noopener noreferrer">צפייה בוידאו</a>}

    {(d?.gallery?.length ?? 0) > 0 && <section class="gallery"><h2>גלריית תמונות</h2>{d?.gallery?.map((image) => image.url && <img src={`${image.url}?w=320&fit=max`} alt={`${d?.name ?? 'שבט אמהות'} - תמונת גלריה`} loading="lazy" />)}</section>}

    <ContactForm practitionerName={d?.name ?? ''} practitionerSlug={slug} practitionerType="doula" practitionerEmail={d?.email ?? ''} formId="doula-contact" />
  </article>

  {wa && <a class="btn btn-wa sticky-cta" href={wa}>כתבי וואטסאפ עכשיו ל־{d?.name}</a>}

  <style>
    .profile-photo-wrap { display:flex; justify-content:center; margin:0 0 1.4rem; }
    .profile-photo {
      width: min(240px, 60vw);
      height: min(240px, 60vw);
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid var(--surface);
      box-shadow: var(--shadow-soft);
    }
    .title { color:var(--muted); margin:.2rem 0; }
    .marketing-sentence { color:var(--brand); font-weight:700; margin:.45rem 0; }
    .tagline {
      font-family: var(--sans);
      font-weight: 800;
      font-size: clamp(1.15rem, 1.7vw, 1.4rem);
      color: var(--brand-deep);
      margin: 1.4rem 0 0;
      line-height: 1.5;
    }
    .accompaniment { margin: 2rem 0; }
    .accompaniment h2 { text-align:center; margin-bottom:1.4rem; }
    .accompaniment-grid { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .accompaniment-card { padding:1.6rem; }
    .accompaniment-card-head {
      display:flex;
      align-items:center;
      gap:.7rem;
      margin:0 0 .8rem;
    }
    .accompaniment-icon {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
      width:48px;
      height:48px;
      border-radius:14px;
      color:var(--surface);
      background: linear-gradient(135deg, var(--peach), var(--brand));
    }
    .accompaniment-card h3 { margin:0; font-size:1.2rem; color:var(--heading); }
    .accompaniment-card :global(.legacy-content) h2,
    .accompaniment-card :global(.legacy-content) h3 { margin:0 0 .6rem; font-size:1.2rem; color:var(--heading); }
    .accompaniment-card :global(.legacy-content) > :first-child { margin-top:0; }
    .accompaniment-card :global(.legacy-content) p { margin:0; color:var(--muted); }
    .contact-links { display:flex; gap:.7rem; flex-wrap:wrap; margin:1.2rem 0; }
    .sticky-cta { position:fixed; inset-inline:auto 1rem; bottom:1rem; z-index:40; text-align:center; box-shadow:0 8px 24px -8px rgba(0,0,0,.4); }
    @media(min-width:700px){ .sticky-cta{ inset-inline:auto 2rem; } }

    .profile-facts { margin:1.6rem 0 2rem; }
    .profile-facts-grid { grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); }
    .profile-fact-card { padding:1.2rem; }
    .profile-fact-card h2 { margin:0 0 .8rem; font-size:1.15rem; color:var(--heading); }
    .profile-fact-list { display:flex; flex-wrap:wrap; gap:.5rem; margin:0; padding:0; list-style:none; }
    .profile-fact-list li { border:1px solid var(--line); border-radius:999px; padding:.25rem .65rem; background:var(--peach-soft); font-size:.92rem; }

    .ig-embed {
      display: flex;
      align-items: center;
      gap: .8rem;
      margin: 1.2rem 0;
      padding: .9rem 1.1rem;
      border-radius: 1rem;
      color: inherit;
      text-decoration: none;
      background: linear-gradient(135deg, var(--peach-soft), var(--surface));
      border: 1px solid var(--line);
      box-shadow: var(--shadow-soft);
    }
    .ig-embed-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      flex-shrink: 0;
      border-radius: 14px;
      color: var(--surface);
      background: linear-gradient(135deg, var(--peach), var(--brand));
    }
    .ig-embed-body { display: flex; flex-direction: column; gap: .15rem; }
    .ig-embed-handle { color: var(--muted); font-size: .92rem; }

    .ig-post-embed { display: flex; flex-direction: column; align-items: center; gap: .8rem; margin: 1.2rem 0; padding: 1rem; text-align: center; border: 1px solid var(--line); border-radius: 1rem; background: var(--surface); }
    .ig-post-embed p { margin: 0; color: var(--muted); }
    .ig-post-embed :global(iframe) { max-width: 100%; }

    .video-frame {
      position: relative;
      width: min(420px, 90vw);
      aspect-ratio: 9 / 16;
      margin: 1.8rem auto;
      border-radius: 1.4rem;
      overflow: hidden;
      background: var(--ink);
      box-shadow: var(--shadow-soft);
    }
    .video-frame iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .video-cover-button {
      position:absolute;
      inset:0;
      display:grid;
      place-items:center;
      width:100%;
      height:100%;
      padding:0;
      border:0;
      color:var(--surface);
      background:var(--ink);
      cursor:pointer;
    }
    .video-cover-button img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
    .video-play-icon { position:relative; z-index:1; display:grid; place-items:center; width:72px; height:72px; border-radius:50%; background:rgba(58,47,36,.86); box-shadow:var(--shadow-soft); }
    .video-cover-button:focus-visible { outline:3px solid var(--peach); outline-offset:-6px; }
    details { border:1px solid rgba(58,47,36,.14); border-radius:1rem; padding:1rem; margin:.8rem 0; background:var(--surface); }
    summary { cursor:pointer; font-weight:700; color:var(--brand); }
    .gallery { margin:2rem 0; display:flex; flex-wrap:wrap; gap:.6rem; }
    .gallery img { width:160px; height:160px; object-fit:cover; border-radius:1rem; box-shadow:var(--shadow-soft); }
    @media (max-width: 640px) {
      .gallery img { width:calc(50% - .3rem); height:auto; aspect-ratio:1; }
    }
  </style>
  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-instagram-load]").forEach((button) => {
      button.addEventListener("click", () => {
        const embed = button.parentElement?.querySelector<HTMLElement>(".instagram-media");
        if (!embed) return;
        embed.hidden = false;
        button.hidden = true;

        const existingScript = document.querySelector<HTMLScriptElement>('script[src="https://www.instagram.com/embed.js"]');
        if (existingScript) {
          const instagram = (window as Window & {instgrm?: {Embeds?: {process?: () => void}}}).instgrm;
          instagram?.Embeds?.process?.();
          return;
        }
        const script = document.createElement("script");
        script.async = true;
        script.src = "https://www.instagram.com/embed.js";
        document.body.appendChild(script);
      }, { once: true });
    });

    document.querySelectorAll<HTMLButtonElement>("[data-video-cover]").forEach((cover) => {
      cover.addEventListener("click", () => {
        const iframe = cover.parentElement?.querySelector<HTMLIFrameElement>("iframe[data-video-src]");
        const src = iframe?.dataset.videoSrc;
        if (!iframe || !src) return;
        const separator = src.includes("?") ? "&" : "?";
        iframe.src = `${src}${separator}autoplay=1`;
        cover.hidden = true;
      }, { once: true });
    });
  </script>
</Base>
