      .ds-therapist-actions .ds-more { font-size: 13px; }
      .ds-therapist-actions .btn-wa { padding: 6px 14px; font-size: 13px; }

      .ds-article-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 18px; }
      .ds-article-grid .ds-article-body { padding: 16px 18px 20px; }
      .ds-article-grid h5 { font-size: 18px; }

      .ds-benefit-filter { background: linear-gradient(160deg, #e4f3e0, var(--mint)); border: 1px solid rgba(58, 47, 36, 0.08); border-radius: 26px; padding: 20px; margin-bottom: 24px; }
      .ds-benefit-filter-label { font-size: 13px; font-weight: 700; color: var(--brand); margin-bottom: 10px; }
      .ds-benefit-filter-label span { font-weight: 400; color: #4a6b57; }
      .ds-benefit-filter-chips { display: flex; gap: 8px; flex-wrap: wrap; }
      .ds-benefit-filter-chips span { background: rgba(255, 255, 255, 0.7); color: #4a6b57; border: 1px solid rgba(0, 0, 0, 0.08); border-radius: 999px; padding: 7px 16px; font-size: 13px; font-weight: 600; }
      .ds-benefit-filter-chips .active { background: #fff; color: var(--brand); border-color: var(--brand); font-weight: 700; }
      .ds-benefit-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 18px; }
      .ds-benefit-grid h5 { font-size: 17px; }
      .ds-benefit-grid .ds-benefit-discount { font-size: 15px; }

      .ds-comm { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; align-items: start; }
      @media (max-width: 760px) { .ds-comm { grid-template-columns: 1fr; } }
      .ds-comm-intro { line-height: 1.85; margin-bottom: 16px; text-wrap: pretty; }
      .ds-comm-steps { display: grid; gap: 10px; margin-bottom: 22px; }
      .ds-comm-steps > div { display: flex; align-items: center; gap: 12px; background: var(--peach-soft); border-radius: 16px; padding: 14px 18px; font-weight: 600; color: var(--ink); }
      .ds-comm-num { flex: 0 0 auto; width: 32px; height: 32px; border-radius: 50%; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; }
      .ds-comm-rules { margin: 0; padding-inline-start: 20px; color: var(--text); font-size: 15px; line-height: 1.8; }
      .ds-comm-form { background: #fff; border: 1px solid var(--line); border-radius: 24px; padding: 24px; box-shadow: var(--shadow-soft); }
      .ds-comm-form-title { font-family: var(--display); font-size: 26px; color: var(--heading); margin-bottom: 6px; }
      .ds-comm-form > p { font-size: 14px; color: var(--muted); margin-bottom: 16px; }
      .ds-comm-fields { display: grid; gap: 12px; }
      .ds-comm-submit { margin-top: 16px; width: 100%; text-align: center; justify-content: center; font-size: 15px; }

      .ds-screen--footer { background: transparent; }
      .ds-foot-contact { background: #fff; padding: 40px; }
      @media (max-width: 640px) { .ds-foot-contact { padding: 28px 16px; } }
      .ds-foot-head { text-align: center; margin-bottom: 26px; }
      .ds-foot-head img { width: 82px; height: auto; margin: 0 auto 12px; display: block; }
      .ds-foot-head h3 { font-family: var(--display); font-size: 34px; color: var(--heading); font-weight: 400; }
      .ds-foot-links { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin-bottom: 28px; }
      .ds-foot-links a { background: var(--cream); border: 1px solid var(--line); border-radius: 16px; padding: 14px 22px; text-decoration: none; text-align: center; min-width: 150px; }
      .ds-foot-links span { display: block; font-size: 20px; margin-bottom: 2px; }
      .ds-foot-links strong { font-weight: 700; color: var(--brand); }
      .ds-legal { background: var(--ink); color: rgba(255, 255, 255, 0.78); padding: 20px 40px; display: flex; flex-wrap: wrap; gap: 10px 22px; align-items: center; justify-content: space-between; font-size: 13px; }
      .ds-legal-links { display: flex; gap: 16px; }
      .ds-legal a { color: var(--peach); text-decoration: none; }

      /* ---- drift log ---- */
      .ds-drift-list { display: grid; gap: 12px; margin-bottom: 32px; }
      .ds-drift { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 18px 22px; display: grid; grid-template-columns: 150px 1fr; gap: 18px; align-items: start; }
      @media (max-width: 640px) { .ds-drift { grid-template-columns: 1fr; gap: 8px; } }
      .ds-badge { border-radius: 999px; padding: 4px 12px; font-size: 12px; font-weight: 700; text-align: center; }
      .ds-badge--cleaned { background: var(--peach-soft); color: var(--brand); }
      .ds-badge--new { background: var(--mint); color: #2f6b4e; }
      .ds-badge--verify { background: #fbe7b0; color: #8a6a12; }
      .ds-badge--kept { background: var(--sky); color: #1f5d77; }
      .ds-drift-title { font-weight: 700; color: var(--ink); margin-bottom: 3px; }
      .ds-drift p { font-size: 14px; color: var(--muted); }

      .ds-next { background: var(--ink); border-radius: 22px; padding: 28px 30px; color: rgba(255, 255, 255, 0.82); }
      .ds-next-title { font-family: var(--display); font-size: 26px; color: var(--peach); margin-bottom: 10px; }
      .ds-next p { max-width: 72ch; margin-bottom: 12px; }
      .ds-next code { color: var(--peach); }
      .ds-next-sub { font-size: 13px; color: rgba(255, 255, 255, 0.5); margin-bottom: 0 !important; }

      @media (prefers-reduced-motion: reduce) {
        .ds *, .ds *::before, .ds *::after { transition: none !important; }
      }
    </style>
  </body>
