---
import '../styles/brand.css'

// Internal design-system reference page — synced from the Claude Design project
// "Shevet Imahot Design System". Documents tokens/components and recreates the
// live WP screens in the rebuilt system. Not linked from the site nav, noindex.

const teeth = ['var(--peach)', 'var(--mint)', 'var(--gold)', 'var(--peach-soft)', 'var(--sky)', 'var(--apricot)']
const zig = (count: number) => Array.from({length: count}, (_, i) => teeth[i % teeth.length])

const palette = [
  {name: 'Brand (espresso)', code: '--brand · #3a2f24', use: 'CTAs, links, active states', color: '#3a2f24'},
  {name: 'Brand deep', code: '--brand-deep · #241c15', use: 'Hover, pressed, shadow tint', color: '#241c15'},
  {name: 'Peach', code: '--peach · #fbcfac', use: 'Tipi in the logo · hero surfaces', color: '#fbcfac'},
  {name: 'Peach soft', code: '--peach-soft · #f8e1ce', use: 'Chips, soft panels, hovers', color: '#f8e1ce'},
  {name: 'Cream', code: '--cream · #f4ece1', use: 'Page background', color: '#f4ece1'},
  {name: 'Surface', code: '--surface · #ffffff', use: 'Cards, forms, panels', color: '#ffffff', bordered: true},
]
const tints = [
  {name: 'Mint', hex: '#cde9ca'},
  {name: 'Sky', hex: '#bfe6f3'},
  {name: 'Gold', hex: '#f2c84b'},
  {name: 'Apricot', hex: '#ffbc7d'},
  {name: 'Beige', hex: '#cda88b'},
  {name: 'WhatsApp', hex: '#25d366'},
]
const textSwatches = [
  {name: 'Heading #3d3d3d', hex: '#3d3d3d'},
  {name: 'Ink #3f2230', hex: '#3f2230'},
  {name: 'Text #565656', hex: '#565656'},
  {name: 'Muted #7a7a7a', hex: '#7a7a7a'},
  {name: 'Line #e7d9cb', hex: '#e7d9cb'},
]

const patterns = [
  {title: 'Section header', body: 'Centred, max 60ch: Oron Yad heading + one muted sentence. No eyebrow above H2 on content pages — the eyebrow is reserved for the hero.'},
  {title: 'Directory page', body: 'Title → filter panel → results grid (auto-fill, min 230px) → "load more" → matchmaking form. Always that order, doulas and therapists alike.'},
  {title: 'Empty state', body: 'Never a blank grid. Muted line + a reset-filters button + the matchmaking form pulled up. A zero-result search is the best moment to capture a lead.'},
  {title: 'Every page ends the same', body: "Contact block (email + two Instagram handles) → legal strip. It is the site's only footer; do not invent per-page variants or submission storage."},
  {title: 'RTL', body: 'Logical properties only — <code>margin-inline</code>, <code>border-inline-start</code>. Latin brand names and phone numbers stay LTR inside <code>&lt;bdi&gt;</code>.'},
  {title: 'Accessibility', body: 'Skip link, visible focus on every control, 44px minimum touch target, the WP accessibility toolbar carried over. Peach on white fails contrast — never text.'},
]

const homeFeatures = [
  {tint: 'var(--peach-soft)', title: 'נבחרת הדולות והיועצות', body: 'תכירי את הגוגל החדש שלך. פה תוכלי למצוא את המטפלת המדויקת לך ולצרכים שלך, כולל דירוגים והמלצות אותנטיות שעברו אימות ע״י צוות האתר.', cta: 'לנבחרת →'},
  {tint: 'var(--mint)', title: 'מועצת השבט', body: 'במתחם הווטסאפ שלנו את מוזמנת להכנס לקבוצה עם אמהות כמוך כדי לחלוק, לשתף, להתייעץ ולהתרגש ביחד.', cta: 'לחצי כאן →'},
  {tint: 'var(--sky)', title: 'חוכמת השבט', body: 'מאמרים, סרטונים, הדרכות וסדנאות. עולם שלם של תוכן להריוניות בלחיצת כפתור אחת, בלי לשוטט בפייסבוק ובגוגל.', cta: 'לחצי כאן →'},
  {tint: '#fbe7b0', title: 'הטבות בלעדיות', body: 'נמאס לך לחפש קודים באינסטגרם? פה תוכלי למצוא את כל ההנחות שיש ברשת למוצרים להריון, לידה ולשנים הראשונות.', cta: 'לחצי כאן →'},
]

const doulas = [
  {name: 'גל פילברג', role: 'דולה, רפלקסולוגית ומדריכת הכנה ללידה'},
  {name: 'גלית פרץ', role: 'דולה, מלווה התפתחותית ויועצת שינה'},
  {name: 'דנה מצר', role: 'דולה, מדריכת הכנה ללידה, יועצת שינה'},
  {name: 'דניאלה ישורון', role: 'מתמחה בהריונות ולידות לאחר אובדן, דולה'},
  {name: 'הגר בן דוד', role: 'דולה ביומכנית, מטפלת איקוויליבריו'},
  {name: 'הדס לרנר', role: 'דולה ומדריכת הכנה ללידה, רפלקסולוגית'},
  {name: 'חגית לוינגר סויסה', role: 'דולה, מטפלת איקוויליבריו ועיבוד לידה'},
  {name: 'מאיה גניש', role: 'דולה בגישה של הביומכניקה של הלידה'},
]

const therapists = [
  {name: 'עירית אנג׳ל', field: 'איקוויליבריו', region: 'מרכז'},
  {name: 'שלומית שוסטר', field: 'התפתחות', region: 'שרון'},
  {name: 'אילת פוזניאק', field: 'הכנה כלכלית', region: 'אונליין'},
  {name: 'שרון אזולאי', field: 'פרחי באך', region: 'דרום'},
]

const articles = [
  {tag: 'לידה', title: 'מה באמת קורה בשלב הפעיל של הלידה', excerpt: 'מדריך קצר שיעזור לך לזהות את השלבים ולדעת מתי לצאת לבית החולים.'},
  {tag: 'הריון', title: 'תיק ליולדת — מה באמת צריך לארוז', excerpt: 'רשימה מקוצרת אחרי אלפי לידות, בלי הדברים שלא תיגעי בהם.'},
  {tag: 'הנקה', title: 'הימים הראשונים בהנקה', excerpt: 'למה זה כואב בהתחלה, מתי זה עובר ומתי כדאי לפנות ליועצת.'},
  {tag: 'סדנה', title: 'סדנת הכנה ללידה — מקוונת', excerpt: 'ארבעה מפגשים עם דולות הנבחרת, כולל הקלטות.'},
  {tag: 'הריון', title: 'בדיקות ההריון לפי שבועות', excerpt: 'מה חובה, מה מומלץ ומה אפשר לוותר עליו.'},
  {tag: 'אחרי לידה', title: 'החודש הרביעי — השבועות שאף אחת לא מספרת עליהם', excerpt: 'מה קורה לגוף ולנפש בשישה השבועות שאחרי.'},
]

const benefits = [
  {name: 'הריונית', discount: '20% הנחה על כל האתר'},
  {name: 'טנס ללידה — צירים', discount: '5% הנחה וסט אלקטרודות'},
  {name: 'מנשאים — urban baby wrap', discount: '10% הנחה על כל האתר'},
  {name: 'אנאבלה משאבת הנקה', discount: '10% הנחה על כל האתר'},
  {name: 'כריות ההנקה של מאמאסיטה', discount: '10% הנחה על כריות הנקה'},
  {name: 'CaritLi — כרית להריוניות', discount: '20% הנחה על כל האתר'},
]

const drift = [
  {tone: 'cleaned', badge: 'CLEANED UP', title: 'Duplicate navigation', body: 'The WP markup ships the main menu four times (desktop, mobile, two Elementor duplicates). One nav, one source of truth.'},
  {tone: 'cleaned', badge: 'CLEANED UP', title: 'Heading levels used as styling', body: 'Doula names and their role lines are both <code>&lt;h2&gt;</code> on the live directory. Here: name is the card heading, role is a paragraph.'},
  {tone: 'cleaned', badge: 'CLEANED UP', title: 'Two footers, two legal strips', body: 'Live pages render the copyright line and the "Made with love" credit twice. Collapsed to one footer.'},
  {tone: 'cleaned', badge: 'CLEANED UP', title: 'Filter round-trips', body: 'WP reloads the page on every filter change. The rebuild filters the already-loaded set client-side; "load more" becomes progressive reveal, not a request.'},
  {tone: 'new', badge: 'NEW', title: 'Sticky WhatsApp CTA on profiles', body: "Not on the WP site. Added because the profile page's only job is starting a conversation."},
  {tone: 'new', badge: 'NEW', title: 'Therapist filters: field · region · language', body: 'The live therapist page has no filtering at all. Same panel component as the doula directory, different fields.'},
  {tone: 'cleaned', badge: 'RESOLVED', title: 'Brand colour: espresso #3a2f24, not raspberry', body: "Raspberry #92003b was inherited from the WP theme's link/button colour, never a conscious brand choice — flagged for Keren's review. Reviewed against the live site 2026-07-30: the real CTAs and buttons read as a dark warm neutral, not fuchsia. <code>--brand</code>/<code>--brand-deep</code> are now espresso #3a2f24 / #241c15, keeping the peach/gold/mint logo accents untouched."},
  {tone: 'verify', badge: 'VERIFY', title: 'Body typeface', body: "Assistant is the repo's choice, not a value read off the live theme. Confirm against the WP theme settings before this is locked."},
  {tone: 'verify', badge: 'VERIFY', title: 'Missing taxonomy values', body: 'Support style, budget bands, and the due-date matching rule are still open in <code>ARCHITECTURE.md §9</code>. The filter panel is built to take them; the values are not decided.'},
  {tone: 'kept', badge: 'KEPT', title: 'Accessibility toolbar & skip link', body: 'Legally required and already in use. Carried over verbatim, restyled to the tokens above.'},
  {tone: 'kept', badge: 'KEPT', title: 'Responder owns lead capture', body: 'Matchmaking and contact forms stay embedded or linked through Responder. The static site does not store submissions.'},
]
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/brand/mark.png" />
    <title>Shevet Imahot Design System</title>
    <meta name="description" content="Internal design-system reference for the Shevet Imahot rebuild: foundations, components, patterns, screens and drift log." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="ds">

      <header class="ds-head">
        <img src="/brand/logo.png" alt="Shevet Imahot" width="118" />
        <div class="ds-head-main">
          <div class="ds-kicker">Design System v1</div>
          <div class="ds-title-row">
            <h1 lang="he">שבט אמהות</h1>
            <span class="ds-title-latin">Shevet Imahot</span>
          </div>
          <div class="ds-head-sub">Derived from the live WordPress site · target: the Astro rebuild</div>
        </div>
        <div class="ds-head-meta">
          <span>RTL · Hebrew</span>
          <span>shevet-imahot.co.il</span>
        </div>
      </header>

      <nav class="ds-nav" aria-label="Sections">
        <a href="#foundations">Foundations</a>
        <a href="#components">Components</a>
        <a href="#patterns">Patterns</a>
        <a href="#screens">Screens</a>
        <a href="#drift" class="accent">Drift log</a>
      </nav>

      <!-- ============ FOUNDATIONS ============ -->
      <section id="foundations" class="ds-first">
        <div class="ds-sec-head">
          <h2>Foundations</h2>
          <span class="ds-sec-num">01</span>
        </div>
        <p class="ds-lede">Warm, handmade, intimate. The identity comes from three things and nothing else: the <strong>Oron Yad</strong> handwriting, the <strong>espresso + cream</strong> pairing, and the <strong>pastel tribal zigzag</strong> lifted from the logo. Everything below is a consequence of those three.</p>

        <h3 class="ds-label">Core palette</h3>
        <div class="ds-swatches">
          {palette.map((c) => (
            <div class="ds-swatch">
              <div class:list={['ds-swatch-color', {bordered: c.bordered}]} style={`background:${c.color}`}></div>
              <div class="ds-swatch-meta">
                <div class="ds-swatch-name">{c.name}</div>
                <div class="ds-swatch-code">{c.code}</div>
                <div class="ds-swatch-use">{c.use}</div>
              </div>
            </div>
          ))}
        </div>

        <h3 class="ds-label" style="margin-bottom:6px">Tribal pastels</h3>
        <p class="ds-note" style="margin-bottom:14px;max-width:68ch">Sampled off the zigzag border and crown in the logo. Use only as chip tints, filter-panel washes, and category coding — never as text or button colour.</p>
        <div class="ds-tints">
          {tints.map((t) => (
            <div class="ds-tint">
              <div class="ds-tint-color" style={`background:${t.hex}`}></div>
              <div class="ds-tint-name">{t.name}</div>
              <div class="ds-swatch-code">{t.hex}</div>
            </div>
          ))}
        </div>

        <h3 class="ds-label" style="margin:28px 0 14px">Text &amp; line</h3>
        <div class="ds-textrow">
          {textSwatches.map((t) => (
            <div class="ds-text-swatch">
              <div class="ds-text-color" style={`background:${t.hex}`}></div>
              <div class="ds-tint-name">{t.name}</div>
            </div>
          ))}
        </div>

        <h3 class="ds-label">Typography</h3>
        <div class="ds-type" dir="rtl" lang="he">
          <div class="ds-type-row">
            <div class="ds-type-meta" dir="ltr" lang="en">Display · Oron Yad 400 · clamp(48px, 8vw, 90px) / 1.05</div>
            <div class="ds-t-display">הבית של הדולות הטובות בישראל</div>
          </div>
          <div class="ds-type-row">
            <div class="ds-type-meta" dir="ltr" lang="en">H2 · Oron Yad 400 · clamp(32px, 5vw, 48px) / 1.1</div>
            <div class="ds-t-h2">ברוכה הבאה לשבט</div>
          </div>
          <div class="ds-type-row">
            <div class="ds-type-meta" dir="ltr" lang="en">H3 / card title · Assistant 700 · 21px / 1.25</div>
            <div class="ds-t-h3">נבחרת הדולות, היועצות והמטפלות</div>
          </div>
          <div class="ds-type-row">
            <div class="ds-type-meta" dir="ltr" lang="en">Body lead · Assistant 400 · 20px / 1.65</div>
            <div class="ds-t-lead">אם את בהריון – שבט אמהות הוא המקום למצוא בו את הדולה שלך או כל אשת מקצוע בתחום ההריון והלידה.</div>
          </div>
          <div class="ds-type-row">
            <div class="ds-type-meta" dir="ltr" lang="en">Body · Assistant 400 · 16px / 1.65</div>
            <div class="ds-t-body">מחפשת אשת מקצוע בתחום ההורות הלידה או ההריון? תכירי את הגוגל החדש שלך. פה תוכלי למצוא את המטפלת המדויקת לך ולצרכים שלך, כולל דירוגים והמלצות אותנטיות שעברו אימות ע״י צוות האתר.</div>
          </div>
          <div class="ds-type-row">
            <div class="ds-type-meta" dir="ltr" lang="en">Eyebrow / label · Assistant 700 · 12px · 0.18em tracking · uppercase</div>
            <div class="ds-t-eyebrow">שבט אמהות</div>
          </div>
        </div>
        <div class="ds-duo">
          <div class="ds-tile">
            <div class="ds-tile-title">Oron Yad — display only</div>
            <p>Hero lines, section headings, the logotype. Never for body, never below 28px, never bold (it has one weight). It has no Latin coverage worth using — English headings fall back to Assistant 700.</p>
          </div>
          <div class="ds-tile">
            <div class="ds-tile-title">Assistant — everything else</div>
            <p>Card titles, body, nav, buttons, forms. Weights 400 / 600 / 700 only. Two families total — the WP site drifted into four; the rebuild does not.</p>
          </div>
        </div>

        <h3 class="ds-label">Space, radius, elevation</h3>
        <div class="ds-found">
          <div class="ds-tile">
            <div class="ds-tile-title">Spacing — 4px base</div>
            <div class="ds-space-steps">
              {[4, 8, 12, 16, 24, 32, 48].map((s) => (
                <div style={`width:${s}px;height:${s}px;background:var(--brand)`}></div>
              ))}
            </div>
            <p>4 · 8 · 12 · 16 · 24 · 32 · 48 · 64. Section rhythm <code>clamp(40px, 6vw, 72px)</code>. Content width <code>1100px</code>.</p>
          </div>
          <div class="ds-tile">
            <div class="ds-tile-title">Radius</div>
            <div class="ds-radius-row">
              <div style="border-radius:12px">12</div>
              <div style="border-radius:18px">18</div>
              <div style="border-radius:24px">24</div>
              <div class="pill">pill</div>
            </div>
            <p>Inputs 12 · panels 18 · cards 24 · filter panel 26 · buttons and chips always pill.</p>
          </div>
          <div class="ds-tile">
            <div class="ds-tile-title">Elevation</div>
            <div class="ds-elev-row">
              <div style="box-shadow:var(--shadow-soft)">soft</div>
              <div style="box-shadow:var(--shadow-lift)">lift</div>
            </div>
            <p>Warm espresso-tinted, never flat black. Tactile, not glossy SaaS.</p>
          </div>
          <div class="ds-tile">
            <div class="ds-tile-title">Motion</div>
            <p>180–300ms ease. Animate <code>transform</code>, <code>opacity</code>, <code>color</code> only. Cards lift −4px, buttons lift −2px and press to 0.98. Honour <code>prefers-reduced-motion</code>.</p>
          </div>
        </div>
      </section>

      <!-- ============ COMPONENTS ============ -->
      <section id="components">
        <div class="ds-sec-head">
          <h2>Components</h2>
          <span class="ds-sec-num">02</span>
        </div>
        <p class="ds-lede">Every component below appears on the live WordPress site. Specimens are RTL because the product is.</p>

        <h3 class="ds-label">Buttons</h3>
        <div class="ds-panel ds-panel--row" dir="rtl" lang="he">
          <a href="#components" class="btn">לנבחרת הדולות</a>
          <a href="#components" class="btn btn-outline">לכל הפרטים</a>
          <a href="#components" class="btn btn-wa"><span aria-hidden="true">✆</span> שלחי הודעה בוואטסאפ</a>
          <a href="#components" class="ds-link">לפרטים נוספים ←</a>
          <span class="ds-btn-disabled">שליחה</span>
        </div>
        <div class="ds-note" style="margin-bottom:36px">Primary · outline · WhatsApp · inline link · disabled. Focus ring is always <code>3px #fbcfac</code> at 3px offset — visible on cream and on white.</div>

        <h3 class="ds-label">Chips</h3>
        <div class="ds-panel ds-panel--chips" dir="rtl" lang="he">
          <span class="chip t-peach">הכנה ללידה</span>
          <span class="chip t-mint">רפלקסולוגיה</span>
          <span class="chip t-sky">יועצת שינה</span>
          <span class="chip t-gold">הנקה</span>
          <span class="chip t-apricot">איקוויליבריו</span>
          <span class="ds-chip-active">איכילוב ✕</span>
        </div>
        <div class="ds-note" style="margin-bottom:36px">Tints rotate by taxonomy, not by mood — one tint per field so a doula's specialities stay recognisable across the directory. The last variant is a removable active filter.</div>

        <h3 class="ds-label">Cards</h3>
        <div class="ds-cards" dir="rtl" lang="he">
          <div class="ds-doula-card">
            <div class="ds-avatar"></div>
            <h4>דנה מצר</h4>
            <p class="ds-doula-role">דולה, מדריכת הכנה ללידה, יועצת שינה</p>
            <div class="ds-doula-tags">
              <span class="chip t-peach">איכילוב</span>
              <span class="chip t-mint">תל אביב</span>
            </div>
            <a href="#components" class="ds-more">לפרטים נוספים</a>
          </div>
          <div class="ds-article-card">
            <div class="ds-article-cover"></div>
            <div class="ds-article-body">
              <div class="ds-card-tags"><span class="chip t-sky">מאמר</span></div>
              <h4>מה באמת קורה בשלב הפעיל של הלידה</h4>
              <p>מדריך קצר שיעזור לך לזהות את השלבים ולדעת מתי לצאת לבית החולים.</p>
            </div>
          </div>
          <div class="ds-benefit-card">
            <div class="ds-benefit-logo"></div>
            <h4>הריונית</h4>
            <p class="ds-benefit-discount">20% הנחה על כל האתר</p>
            <p class="ds-benefit-code">קוד קופון: <code>SHEVET20</code></p>
            <a href="#components" class="btn ds-btn-sm">לפרטים על ההטבה</a>
          </div>
        </div>
        <div class="ds-note" style="margin-bottom:36px">Doula (circular portrait, centred) · article (16:10 cover) · benefit (logo + discount + code). All three share the same border, radius family and soft shadow so a mixed grid still reads as one system.</div>

        <h3 class="ds-label">Filter panel</h3>
        <div class="ds-filter" dir="rtl" lang="he">
          <label>בית חולים
            <select><option>בא לי ללדת ב..</option><option>איכילוב</option><option>אסותא אשדוד</option><option>בלינסון</option></select></label>
          <label>תאריך לידה משוער
            <input type="date" /></label>
          <label>שם הדולה
            <input type="text" placeholder="חיפוש חופשי" /></label>
          <button type="button" class="ds-fbtn">חפשו לי את האחת</button>
