---
import '../styles/brand.css'
import AccessibilityToolbar from '../components/AccessibilityToolbar.astro'
import ZigZag from '../components/ZigZag.astro'
import { getSiteSettings } from '../lib/queries'
import {instagramHref, mailtoHref, telHref} from '../lib/contact'
const {title = 'שבט אמהות', description = ''} = Astro.props
const gtm = import.meta.env.PUBLIC_GTM_ID // set per environment
const settings = await getSiteSettings()
const phoneHref = telHref(settings?.phone)
const navLinks = [
  {href: '/doulas/', label: 'נבחרת הדולות'},
  {href: '/professionals/', label: 'נבחרת היועצות והמטפלות'},
  {href: '/articles/', label: 'מאמרים'},
  {href: '/workshops/', label: 'ספריית סדנאות'},
  {href: '/benefits/', label: 'הטבות'},
  {href: '/community/', label: 'קבוצות הווטסאפ'},
]
const path = Astro.url.pathname
const isActive = (href: string): boolean => path === href || path.startsWith(href)
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/brand/mark.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&display=swap" rel="stylesheet" />
    {/* TODO: gate behind cookie consent per Israeli privacy law before loading */}
    {gtm && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtm}');`} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">דילוג לתוכן הראשי</a>
    <header class="wrap site-head">
		<a href="/" class="logo"><img src="/brand/old-logo.png" alt="שבט אמהות" width="300" height="193" /></a>
      <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="תפריט">
        <span class="nav-toggle-lines" aria-hidden="true"></span>
      </button>
      <nav id="site-nav">
        {navLinks.map((l) => (
          <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="foot-contact">
        <div class="wrap">
          <img class="foot-mark" src="/brand/mark.png" alt="" width="82" />
          <h2>רוצה עזרה במציאת דולה?</h2>
          <p class="foot-lead">תני לנו למצוא לך את השידוך המדויק</p>
          <a class="btn btn-wa foot-wa-cta" href="https://katzr.net/2975d7">
            <svg class="wa-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.472-.148-.67.15-.198.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.148.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
              <path d="M12.001 2C6.478 2 2 6.477 2 12c0 1.99.585 3.845 1.596 5.405L2 22l4.735-1.556A9.953 9.953 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2zm0 18.09c-1.66 0-3.207-.48-4.51-1.31l-.323-.19-3.13 1.03 1.045-3.05-.207-.313A8.075 8.075 0 0 1 3.91 12c0-4.462 3.63-8.09 8.091-8.09 4.462 0 8.09 3.628 8.09 8.09 0 4.462-3.628 8.09-8.09 8.09z"></path>
            </svg>
            וואטסאפ
          </a>
          <div class="foot-tiles">
            {settings?.email && (
              <a class="foot-tile" href={mailtoHref(settings.email)}>
                <span aria-hidden="true">✉</span>
                <strong>אימייל</strong>
              </a>
            )}
            {settings?.instagram && (
              <a class="foot-tile" href={instagramHref(settings.instagram)}>
                <span aria-hidden="true">◎</span>
                <strong>קרן</strong>
              </a>
            )}
            {settings?.instagramSecondary && (
              <a class="foot-tile" href={instagramHref(settings.instagramSecondary)}>
                <span aria-hidden="true">◎</span>
                <strong>עירית</strong>
              </a>
            )}
          </div>
        </div>
      </div>
      <ZigZag />
      <div class="legal-strip">
        <div class="wrap legal-inner">
          <span>כל הזכויות שמורות לשבט אמהות{settings?.phone && phoneHref && <> · <a class="legal-phone" href={phoneHref}><bdi>{settings.phone}</bdi></a></>}</span>
          <nav class="foot-legal" aria-label="קישורים משפטיים">
            <a href="/welcome/">ברוכות הבאות</a>
            <a href="/team/">הצוות</a>
            <a href="/privacy/">מדיניות פרטיות</a>
            <a href="/terms/">תנאי שימוש</a>
            <a href="/accessibility/">הצהרת נגישות</a>
          </nav>
        </div>
      </div>
    </footer>
    <AccessibilityToolbar />
    {/* TODO: consent banner gates GTM ({gtm}) per Israeli privacy law */}
    <script>
      const header = document.querySelector('.site-head')
      const toggle = document.querySelector('.nav-toggle')
      toggle?.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true'
        toggle.setAttribute('aria-expanded', String(!isOpen))
        header?.toggleAttribute('data-nav-open', !isOpen)
      })
    </script>
    <style>
      .skip-link { position:absolute; inset-inline-start:1rem; top:-4rem; z-index:100; background:var(--surface); color:var(--brand); font-weight:700; padding:.65rem 1.3rem; border-radius:999px; box-shadow:var(--shadow-soft); text-decoration:none; transition:top .18s ease; }
      .skip-link:focus-visible { top:1rem; outline:3px solid var(--peach); outline-offset:3px; }
      .site-head { display:flex; align-items:center; justify-content:space-between; padding-block:.25rem; gap:1rem; position:relative; background:var(--surface); }
      .logo { display:inline-flex; }
      .logo img { height: 46px; width:auto; }
      .nav-toggle { display:none; border:0; background:transparent; color:var(--ink); padding:.6rem; }
      .nav-toggle-lines, .nav-toggle-lines::before, .nav-toggle-lines::after { display:block; width:1.45rem; height:2px; border-radius:999px; background:currentColor; content:""; }
      .nav-toggle-lines { position:relative; }
      .nav-toggle-lines::before, .nav-toggle-lines::after { position:absolute; inset-inline-start:0; }
      .nav-toggle-lines::before { top:-.45rem; }
      .nav-toggle-lines::after { top:.45rem; }
      .nav-toggle:focus-visible, .site-head nav a:focus-visible { outline:3px solid var(--peach); outline-offset:3px; }
      .site-head nav { display:flex; gap:1.1rem; flex-wrap:wrap; }
      .site-head nav a { text-decoration:none; color: var(--ink); font-size:.95rem; font-weight:600; transition:color .18s ease, transform .18s ease; }
      .site-head nav a:hover { transform:translateY(-1px); }
      .site-head nav a:hover { color:var(--brand); }
      .site-head nav a[aria-current="page"] { border-bottom:2px solid var(--brand); padding-bottom:3px; }

      /* shared page ending: contact block → zigzag → legal strip */
      .site-foot { margin-top:3rem; }
      .foot-contact { background:var(--surface); border-top:1px solid var(--line); padding-block:2.6rem 2.4rem; text-align:center; }
      .foot-mark { width:82px; height:auto; margin:0 auto .8rem; display:block; }
      .foot-contact h2 { margin:0 0 .5rem; font-size:clamp(1.8rem, 4vw, 2.15rem); }
      .foot-lead { margin:0 0 1.4rem; color:var(--ink); }
      .foot-wa-cta { margin-bottom:1.8rem; }
      .foot-tiles { display:flex; justify-content:center; gap:.9rem; flex-wrap:wrap; margin-bottom:1.8rem; }
      .foot-tile { background:var(--cream); border:1px solid var(--line); border-radius:16px; padding:.9rem 1.4rem; text-decoration:none; text-align:center; min-width:150px; transition:transform .18s ease, background .18s ease; }
      .foot-tile:hover { transform:translateY(-2px); background:var(--peach-soft); }
      .foot-tile:focus-visible { outline:3px solid var(--peach); outline-offset:3px; }
      .foot-tile span { display:block; font-size:1.25rem; margin-bottom:.15rem; color:var(--ink); }
      .foot-tile strong { font-weight:700; color:var(--brand); }
      .legal-strip { background:var(--ink); color:rgba(255, 255, 255, 0.78); font-size:.85rem; }
      .legal-inner { display:flex; flex-wrap:wrap; gap:.6rem 1.4rem; align-items:center; justify-content:space-between; padding-block:1.2rem; }
      .legal-phone, .foot-legal a { color:var(--peach); text-decoration:none; }
      .legal-phone:hover, .foot-legal a:hover { text-decoration:underline; }
      .legal-phone:focus-visible, .foot-legal a:focus-visible { outline:3px solid var(--peach); outline-offset:3px; }
      .foot-legal { display:flex; gap:1rem; flex-wrap:wrap; }
      @media (max-width: 700px) {
        .site-head { justify-content:center; padding-block:.35rem; }
        .logo img { height:49px; }
        .nav-toggle { display:inline-block; }
        .nav-toggle { position:absolute; right:1rem; }
        .site-head nav { display:none; position:absolute; inset-inline:1rem; top:calc(100% + .35rem); z-index:10; background:var(--cream); border:1px solid var(--line); border-radius:18px; box-shadow:0 18px 40px -28px rgba(63, 34, 48, .65); padding:.8rem; }
        .site-head[data-nav-open] nav { display:grid; gap:.35rem; }
        .site-head nav a { padding:.55rem .7rem; border-radius:12px; }
        .site-head nav a:hover { background:var(--peach-soft); }
        .site-head nav a[aria-current="page"] { border-bottom:0; background:var(--peach-soft); }
      }
    </style>
  </body>
</html>
